{
  "uid": "fleetops-overview",
  "title": "FleetOps – Giám sát hệ thống",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU theo container (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service)(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service!=\"\"}[1m]))*100",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RAM theo container",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service)(container_memory_working_set_bytes{container_label_com_docker_compose_service!=\"\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Nginx – kết nối đang hoạt động",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_connections_active",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Nginx – request/giây",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total[1m])",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PostgreSQL – số kết nối hoạt động",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_activity_count)",
          "legendFormat": "connections"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PostgreSQL – giao dịch commit/giây (CSDL fleetops)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"fleetops\"}[1m]))",
          "legendFormat": "commit/s"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Webapp FleetOps – đăng nhập thất bại / phút",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(fleetops_login_failed_total[1m])",
          "legendFormat": "login failed"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Webapp FleetOps – thời gian xử lý trung bình (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fleetops_http_request_duration_seconds_sum[1m]))/sum(rate(fleetops_http_request_duration_seconds_count[1m]))",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Log ứng dụng FleetOps (sự kiện bảo mật)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"webapp\"} |~ \"LOGIN_FAILED|ALERT_RECEIVED|ERROR\""
        }
      ]
    }
  ]
}
