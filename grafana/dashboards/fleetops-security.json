{
  "uid": "fleetops-security",
  "title": "FleetOps – Nhật ký & An toàn thông tin",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Đăng nhập thất bại (5 phút)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"webapp\"} |= \"LOGIN_FAILED\" [5m]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request bị Nginx chặn 429 (5 phút)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"nginx\"} |= \" 429 \" [5m]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cảnh báo Firing nhận qua Webhook",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 10, "y": 0, "w": 4, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"webapp\"} |= \"ALERT_RECEIVED\" [15m]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tần suất đăng nhập sai mỗi phút (Brute-force Detector)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 6 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"webapp\"} |= \"LOGIN_FAILED\" [1m]))",
          "legendFormat": "LOGIN_FAILED / 1m"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Nhật ký bảo mật ứng dụng FleetOps (LOGIN_FAILED & ALERT_RECEIVED)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 10 },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"webapp\"} |~ \"LOGIN_FAILED|ALERT_RECEIVED|LOGIN_SUCCESS\""
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Nhật ký Nginx Reverse Proxy tại /api/login (HTTP 401 & HTTP 429 Rate Limit)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"nginx\"} |= \"POST /api/login\""
        }
      ]
    }
  ]
}
